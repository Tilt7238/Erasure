{
    "name": "Comment Deleter for YouTube",
    "version": "2.8.0",
    "description": "View, search and selectively delete your YouTube comments, live chat messages and community posts.",
    "permissions": ["scripting"],
    "host_permissions": ["https://myactivity.google.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Open Comment Deleter for YouTube",
        "default_icon":
        {
            "16": "images/logo_16.png",
            "32": "images/logo_32.png",
            "48": "images/logo_48.png",
            "128": "images/logo_128.png"
        }
    },
    "icons":
    {
        "16": "images/logo_16.png",
        "32": "images/logo_32.png",
        "48": "images/logo_48.png",
        "128": "images/logo_128.png"
    },
    "manifest_version": 3
}
